{
    "train":{
        "dataset": {
            "module": "torch.utils.data",
            "class_name": "ConcatDataset",
            "args": {
                "datasets":[
                    {
                        "module": "data.synthetic.dataset_synthetic",
                        "class_name": "SynthesisDatasetWrapper",
                        "args": {
                            "length": 50000,
                            "load_raw_data": false,
                            "datasets": [
                                {
                                    "module": "data.synthetic.dataset_ocr",
                                    "class_name": "NumberOcrDataset",
                                    "args": {
                                        "prob": 0.1, 
                                        "root": "/data/datasets/tzhangbu/Cherry-Pick/data/refcoco",
                                        "dataset": "unc",
                                        "split": "train",
                                        "name": "Number OCR"
                                    }
                                },
                                {
                                    "module": "data.synthetic.dataset_ordinal",
                                    "class_name": "RowColumnOrdinalDataset",
                                    "args": {
                                        "prob": 0.2,
                                        "root": "/data/datasets/tzhangbu/Cherry-Pick/data/refcoco",
                                        "dataset": "unc",
                                        "split": "train",
                                        "range_num": [2, 4],
                                        "name": "Row Column Ordinal"
                                    }
                                },
                                {
                                    "module": "data.synthetic.dataset_relative",
                                    "class_name": "RelativeDataset",
                                    "args": {
                                        "prob": 0.5,
                                        "root": "/data/datasets/tzhangbu/Cherry-Pick/data/refcoco",
                                        "dataset": "unc",
                                        "split": "train",
                                        "name": "Relative Dataset"
                                    }
                                },
                                {
                                    "module": "data.synthetic.dataset_polar",
                                    "class_name": "PolarOrdinalDataset",
                                    "args": {
                                        "prob": 0.2,
                                        "root": "/data/datasets/tzhangbu/Cherry-Pick/data/refcoco",
                                        "dataset": "unc",
                                        "split": "train",
                                        "name": "Polar Ordinal Dataset"
                                    }
                                }
                            ]
                        }
                    },
                    {
                        "module": "data.dataset_pseudo",
                        "class_name": "get_dataset",
                        "args":{
                            "root": "/data/datasets/tzhangbu/Cherry-Pick/data/refcoco",
                            "augment_text_root": "augmentation/data",
                            "dataset": "unc+",
                            "split": "train",
                            "max_tokens": 20
                        }
                    }
                ]
            }
        }
    },
    "val": {
        "dataset": {
            "module": "data.dataset_refer_bert",
            "class_name": "get_dataset",
            "args": {
                "image_set": "val", 
                "dataset": "refcoco"
            }
        }
    }
}
