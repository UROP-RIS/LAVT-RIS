{
    "dataset_configs": {
        "module": "torch.utils.data",
        "class_name": "ConcatDataset",
        "args": {
            "datasets":[
                {
                    "module": "data.synthetic.dataset_synthetic",
                    "class_name": "SynthesisDatasetWrapper",
                    "args": {
                        "length": 100,
                        "load_raw_data": false,
                        "datasets": [
                            {
                                "module": "data.synthetic.dataset_ocr",
                                "class_name": "NumberOcrDataset",
                                "args": {
                                    "prob": 0.5, 
                                    "root": "/data/datasets/tzhangbu/Cherry-Pick/data/refcoco",
                                    "dataset": "unc",
                                    "split": "train",
                                    "name": "Number OCR"
                                }
                            },
                            {
                                "module": "data.synthetic.dataset_ordinal",
                                "class_name": "RowColumnOrdinalDataset",
                                "args": {
                                    "prob": 0.3,
                                    "root": "/data/datasets/tzhangbu/Cherry-Pick/data/refcoco",
                                    "dataset": "unc",
                                    "split": "train",
                                    "range_num": [3, 6],
                                    "name": "Row Column Ordinal"
                                }
                            }
                        ]
                    }
                }
            ]
        }
    }
}